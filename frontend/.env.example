# ============================================================
# VENTURI — Frontend Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# On Vercel: add these as Environment Variables in the dashboard.

# The URL of your deployed FastAPI backend (Render URL).
# Leave empty locally — it will automatically use http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
